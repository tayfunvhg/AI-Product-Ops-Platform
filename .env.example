# LLM configuration — read server-side only, never exposed to the browser.
#
# Choose a provider. Default is X5 Copilot. For local testing without the
# corporate VPN you can switch to DeepSeek (public, OpenAI-compatible).
#
#   LLM_PROVIDER=x5        # default
#   LLM_PROVIDER=deepseek  # use DeepSeek instead

LLM_PROVIDER="x5"

# --- X5 Copilot ---
X5_COPILOT_API_KEY="your-key-here"
X5_COPILOT_COMPLETIONS_URL="https://api-copilot.x5.ru/aigw/v1/chat/completions"
X5_COPILOT_MODEL="copilot-flash"
# bearer | x-api-key
X5_COPILOT_AUTH_MODE="bearer"

# --- DeepSeek (alternative for local testing) ---
DEEPSEEK_API_KEY="your-deepseek-key-here"
DEEPSEEK_COMPLETIONS_URL="https://api.deepseek.com/chat/completions"
DEEPSEEK_MODEL="deepseek-chat"
