# X5 Copilot (chat completions) — fill these in to enable live AI agents.
# These are read server-side only and are never exposed to the browser.

X5_COPILOT_API_KEY="your-key-here"
X5_COPILOT_COMPLETIONS_URL="https://api-copilot.x5.ru/aigw/v1/chat/completions"
X5_COPILOT_MODEL="copilot-flash"
# bearer | x-api-key
X5_COPILOT_AUTH_MODE="bearer"
